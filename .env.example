# Copy to .env and fill in values. `make driver` / `make nav` source this file.
# Offline smoke (`make smoke`) does not need ROBOT_IP.

# Unitree Go2 address on the robot LAN (required for Track B).
ROBOT_IP=

# webrtc (default) or cyclonedds
CONN_TYPE=webrtc

# Miniforge/conda root if `conda` is not on PATH.
# Example: /home/you/miniforge3
GO2_CONDA_BASE=

# Override PyTorch wheel index (otherwise each env uses its install script default).
# GO2_TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
